{
  "manifest_version": 3,
  "name": "Native New Tab with Search Switcher",
  "version": "1.0",
  "description": "A native-looking new tab page with search engine switcher.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab"],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
